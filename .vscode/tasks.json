{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "zig: build and run example",
      "type": "shell",
      "command": "zig build && ./zig-out/bin/zigot-modbus",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "zig: test",
      "type": "shell",
      "command": "zig build test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
